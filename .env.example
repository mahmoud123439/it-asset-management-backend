# Copy to .env and fill in real values. Never commit .env.

# If the password contains special characters (@ : / # ?), URL-encode them (e.g. @ -> %40).
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/it_asset_management"

# Use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET="change-me"

PORT=5000

# Only used by `npm run seed:admin`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-too"
