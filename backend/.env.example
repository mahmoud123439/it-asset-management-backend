# Copy to .env and fill in real values. Never commit .env.

# If the password contains special characters (@ : / # ?), URL-encode them (e.g. @ -> %40).
# Used when running the API directly on your machine (npm run dev).
DATABASE_URL=""

# Used by docker compose for the Postgres container and for the backend's DATABASE_URL.
# Required: use a unique random value with only URL-safe characters (letters, digits, - _ .).
POSTGRES_PASSWORD=""

# Required: use a unique random value (at least 32 random bytes).
JWT_SECRET=""

PORT=5000

# Required before provisioning the administrator; use a unique password from a password manager.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
